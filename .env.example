# ── PUDA core ──────────────────────────────────────────────────────────────
NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224
MACHINE_ID=my-instrument

# ── GUI driver ─────────────────────────────────────────────────────────────

# Window title (or app name) cua-driver should target. A unique substring of the
# title is enough. Examples:
#   Windows : Chromeleon, ChemStation, Xcalibur, OpenLAB CDS, Notepad
#   Linux   : Opentrons, gedit   (the app must run under an X11 session)
TARGET_APP=InstrumentSoftwareName
